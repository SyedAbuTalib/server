# VPN / Gluetun
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=YOUR_WIREGUARD_PRIVATE_KEY_HERE
SERVER_COUNTRIES=Switzerland

# System / User
PUID=1000
PGID=1000
TIMEZONE=America/Los_Angeles

# Glance
TAILSCALE_API_KEY=YOUR_TAILSCALE_API_KEY_HERE
SERVER_HOSTNAME=archlinux
SERVER_URL=http://archlinux
WEATHER_LOCATION=Seattle
# Optional: only set if you've followed the "Public Access" section of the README
# PUBLIC_DOMAIN=example.com

# Jellystat (Jellyfin analytics)
JELLYSTAT_DB_USER=jellystat
JELLYSTAT_DB_PASSWORD=GENERATE_A_RANDOM_PASSWORD_HERE
JELLYSTAT_JWT_SECRET=GENERATE_A_RANDOM_HEX_STRING_HERE

# Discord Webhook (shared by Watchtower, Unpackerr, Dejarr)
DISCORD_TOKEN=YOUR_DISCORD_WEBHOOK_TOKEN_HERE
DISCORD_WEBHOOK_ID=YOUR_DISCORD_WEBHOOK_ID_HERE

# Unpackerr / Arr API Keys
SONARR_API_KEY=YOUR_SONARR_API_KEY_HERE
RADARR_API_KEY=YOUR_RADARR_API_KEY_HERE

# Dejarr (weekly AI picks)
# See the "Dejarr" section of the README for how to obtain each of these.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
TRAKT_CLIENT_ID=YOUR_TRAKT_CLIENT_ID_HERE
TRAKT_CLIENT_SECRET=YOUR_TRAKT_CLIENT_SECRET_HERE
TRAKT_REFRESH_TOKEN=YOUR_TRAKT_REFRESH_TOKEN_HERE
JELLYSEERR_API_KEY=YOUR_JELLYSEERR_API_KEY_HERE
